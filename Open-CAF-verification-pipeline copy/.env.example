# ==============================================================================
# OPEN CAF - ENVIRONMENT CONFIGURATION
# NCSC Cyber Assessment Framework Platform for UK Local Authorities
# ==============================================================================

# Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Open CAF"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=caf_admin
POSTGRES_PASSWORD=caf_secure_password_change_in_prod
POSTGRES_DB=open_caf_db
DATABASE_URL=postgresql+asyncpg://caf_admin:caf_secure_password_change_in_prod@db:5432/open_caf_db
DATABASE_SYNC_URL=postgresql://caf_admin:caf_secure_password_change_in_prod@db:5432/open_caf_db

# Application Security & JWT
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (MinIO / Local Encrypted Filesystem)
STORAGE_TYPE=local
STORAGE_DIR=/app/storage_data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=opencaf-evidence

# AI Copilot Configuration (Local Ollama or Cloud API)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.3:70b
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Open CAF Local Authority"
